# Копия этого файла для себя: .env (он в .gitignore и в репозиторий не попадает).
# Запуск с файлом: node --env-file=.env server.js
# Для docker compose значения можно положить в такой же .env рядом с docker-compose.yml.

PORT=3100
# 127.0.0.1 = только этот компьютер, 0.0.0.0 = доступно из сети
HOST=127.0.0.1

# 1, когда сайт открывается по https (кука получает флаг Secure)
COOKIE_SECURE=0
# 1, если приложение стоит за nginx/Caddy и нужен настоящий IP клиента
TRUST_PROXY=0

# Куда класть базу и загрузки (по умолчанию data/football.db и uploads/)
# DB_PATH=
# UPLOADS_DIR=

# Напоминания: свои ключи VAPID (иначе создадутся сами рядом с базой)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
